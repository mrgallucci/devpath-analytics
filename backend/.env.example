# development mantém as operações de escrita habilitadas.
# production transforma a API pública em somente leitura.
ENVIRONMENT=development

# Frontends autorizados, separados por vírgula.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opcional. Sem esta variável, usa backend/devpath.db.
# Para produção, pode apontar para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/devpath
